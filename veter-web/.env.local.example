# Turso — https://turso.tech
# Local dev: usa file:./contacto.db (no necesita authToken)
# Producción: usa la URL y token de tu BD en Turso
TURSO_DATABASE_URL=file:./contacto.db
TURSO_AUTH_TOKEN=

# Resend — https://resend.com
# Verifica el dominio veter.es en el panel de Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
